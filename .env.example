# Application identity and environment
APP_NAME=market-insights-api
APP_ENV=local
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# HTTP server
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
WORKERS=1
ENABLE_DOCS=true

# Infrastructure. Use injected secrets outside local development.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/marketinsights
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# Comma-separated values
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Generate a strong unique value for non-local environments; never commit it.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Existing SDK provider configuration
MARKET_PROVIDER=fmp
MARKET_FMP_API_KEY=replace-with-your-provider-api-key
MARKET_REQUEST_TIMEOUT=30
